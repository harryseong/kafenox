// Shared build settings. Everything lives here rather than in the Xcode
// inspector so changes are reviewable in a diff instead of surfacing as
// opaque pbxproj noise.

PRODUCT_BUNDLE_IDENTIFIER = com.harryseong.kafenox$(BUNDLE_ID_SUFFIX)
IPHONEOS_DEPLOYMENT_TARGET = 26.0

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES

ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
